<Window x:Class="Sothe.SotheDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sothe"
        Title="Sothe" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Border Margin="28" CornerRadius="16" Background="#0E0C15" BorderBrush="{StaticResource Stroke2}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#7C3AED" BlurRadius="36" ShadowDepth="0" Opacity="0.45"/>
    </Border.Effect>
    <Grid Margin="28,24,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Border x:Name="AccentBar" Width="4" Height="22" CornerRadius="2" Background="{StaticResource AccentGradient}" Margin="0,0,12,0"/>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource TextSub}" FontSize="14.5" LineHeight="22"/>
      </ScrollViewer>

      <TextBox x:Name="InputBox" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed"/>

      <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource Extreme}" FontSize="13.5" Margin="2,10,0,0"
                 TextWrapping="Wrap" Visibility="Collapsed"/>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button x:Name="BtnCancel" Style="{StaticResource Btn}" Content="{Binding [dlg.cancel], Source={x:Static local:Loc.Instance}}" MinWidth="120" Margin="0,0,10,0"/>
        <Button x:Name="BtnOk" Style="{StaticResource BtnPrimary}" Content="{Binding [dlg.ok], Source={x:Static local:Loc.Instance}}" MinWidth="140" Margin="0" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
