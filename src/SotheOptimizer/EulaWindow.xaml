<Window x:Class="Sothe.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sothe"
        Title="{Binding [eula.title], Source={x:Static local:Loc.Instance}}" Height="600" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource SotheWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="Assets/icon.ico">
  <!-- Contenedor organico: ventana sin marco con esquinas redondeadas (comportamiento en BorderlessWindow.cs) -->
  <Border x:Name="RootBorder" CornerRadius="8" Background="#050505" BorderBrush="#1A1A24" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource Aura}" IsHitTestVisible="False"/>

      <!-- Barra de titulo propia: arrastre con DragMove; cerrar equivale a "No acepto" -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtn}" ToolTip="{Binding [win.minimize], Source={x:Static local:Loc.Instance}}">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0,5.5 H 10"/>
          </Button>
          <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionBtnClose}" ToolTip="{Binding [win.close], Source={x:Static local:Loc.Instance}}">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="30,0,30,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="HeaderBar" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" Background="Transparent">
          <!-- Logo: daga neón de Sothe, estilo cyberpunk (recurso SotheLogo en Themes/SotheTheme.xaml) -->
          <Image Source="{StaticResource SotheLogo}" Width="52" Height="52" Stretch="Uniform"
                 Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
              <DropShadowEffect Color="#D946EF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
            </Image.Effect>
          </Image>
          <StackPanel Margin="0" VerticalAlignment="Center">
            <TextBlock Text="TOJI" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrandGradient}"/>
            <TextBlock Text="{Binding [eula.heading], Source={x:Static local:Loc.Instance}}" FontSize="13.5" Foreground="{StaticResource TextDim}"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Foreground="{StaticResource TextSub}" TextWrapping="Wrap" FontSize="14.5" LineHeight="23"
              Text="{Binding [eula.body], Source={x:Static local:Loc.Instance}}"/>
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="© 2026 " FontSize="12.5" Foreground="{StaticResource TextDim}"/>
            <TextBlock Text="Sothe" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}"/>
            <TextBlock Text=" · Toji" FontSize="12.5" Foreground="{StaticResource TextDim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LangBtn" Style="{StaticResource Pill}" Margin="0,0,16,0" Padding="14,7" FontSize="12.5" FontWeight="Bold" Content="ES"/>
            <Button x:Name="BtnDecline" Style="{StaticResource Btn}" Content="{Binding [eula.decline], Source={x:Static local:Loc.Instance}}" MinWidth="130" Margin="0,0,10,0"/>
            <Button x:Name="BtnAccept" Style="{StaticResource BtnPrimary}" Content="{Binding [eula.accept], Source={x:Static local:Loc.Instance}}" MinWidth="170" Margin="0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
