<Window x:Class="Sothe.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sothe Optimizer · Aviso legal" Height="600" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource SotheWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="Assets/icon.ico">
  <!-- Contenedor organico: ventana sin marco con esquinas redondeadas (comportamiento en BorderlessWindow.cs) -->
  <Border x:Name="RootBorder" CornerRadius="8" Background="#050505" BorderBrush="#1A1A24" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource Aura}" IsHitTestVisible="False"/>

      <!-- Barra de titulo propia: arrastre con DragMove; cerrar equivale a "No acepto" -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtn}" ToolTip="Minimizar">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0,5.5 H 10"/>
          </Button>
          <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionBtnClose}" ToolTip="Cerrar">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="30,0,30,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="HeaderBar" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" Background="Transparent">
          <!-- Logo: daga neón de Sothe, estilo cyberpunk (recurso SotheLogo en Themes/SotheTheme.xaml) -->
          <Image Source="{StaticResource SotheLogo}" Width="52" Height="52" Stretch="Uniform"
                 Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
              <DropShadowEffect Color="#D946EF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
            </Image.Effect>
          </Image>
          <StackPanel Margin="0" VerticalAlignment="Center">
            <TextBlock Text="SOTHE" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrandGradient}"/>
            <TextBlock Text="Aviso legal · léelo antes de continuar" FontSize="13.5" Foreground="{StaticResource TextDim}"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Foreground="{StaticResource TextSub}" TextWrapping="Wrap" FontSize="14.5" LineHeight="23"
              Text="Sothe Optimizer es una herramienta para usuarios avanzados que modifica ajustes profundos de Windows (registro, servicios, seguridad).&#10;&#10;AL ACEPTAR, ENTIENDES Y ASUMES QUE:&#10;&#10;- Usas Sothe Optimizer bajo tu propia responsabilidad y riesgo.&#10;- Algunos ajustes desactivan protecciones de seguridad o pueden causar inestabilidad, pérdida de datos o que Windows deje de arrancar.&#10;- Debes crear un punto de restauración antes de aplicar cambios.&#10;- Los ajustes marcados como PROHIBIDO están ocultos tras el Modo Avanzado y solo deben usarlos personas que sepan lo que hacen.&#10;- El autor de Sothe Optimizer NO se hace responsable de ningún daño, pérdida de datos, inestabilidad ni de cualquier consecuencia derivada del uso del programa.&#10;- El software se ofrece 'TAL CUAL', sin garantía de ningún tipo.&#10;&#10;Si no estás de acuerdo, cierra el programa."/>
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="© 2026 " FontSize="12.5" Foreground="{StaticResource TextDim}"/>
            <TextBlock Text="Sothe" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}"/>
            <TextBlock Text=" · Sothe Optimizer" FontSize="12.5" Foreground="{StaticResource TextDim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnDecline" Style="{StaticResource Btn}" Content="No acepto" MinWidth="130" Margin="0,0,10,0"/>
            <Button x:Name="BtnAccept" Style="{StaticResource BtnPrimary}" Content="Acepto y continúo" MinWidth="170" Margin="0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
