<Window x:Class="Sothe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sothe Optimizer" Height="900" Width="1280" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Style="{StaticResource SotheWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Icon="Assets/icon.ico">
  <WindowChrome.WindowChrome>
    <!-- Sin barra nativa: solo se conserva el borde invisible para redimensionar -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <!-- Contenedor organico: ventana sin marco con esquinas redondeadas (comportamiento en BorderlessWindow.cs) -->
  <Border x:Name="RootBorder" CornerRadius="8" Background="#050505" BorderBrush="#1A1A24" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- Aura morada de fondo -->
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource Aura}" IsHitTestVisible="False"/>

      <!-- ================= Barra de titulo propia: se arrastra con DragMove y lleva los botones de ventana ================= -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtn}" ToolTip="Minimizar">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0,5.5 H 10"/>
          </Button>
          <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtn}" ToolTip="Maximizar">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
          </Button>
          <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionBtnClose}" ToolTip="Cerrar">
            <Path Style="{StaticResource CaptionGlyph}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="28,0,28,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Cabecera de marca ================= -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,16" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <!-- Logo: daga neón de Sothe, estilo cyberpunk (recurso SotheLogo en Themes/SotheTheme.xaml) -->
            <Image Source="{StaticResource SotheLogo}" Width="58" Height="58" Stretch="Uniform"
                   Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Effect>
                <DropShadowEffect Color="#D946EF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
              </Image.Effect>
            </Image>
            <StackPanel Margin="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="SOTHE" FontSize="32" FontWeight="Black" Foreground="{StaticResource BrandGradient}">
                  <TextBlock.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                  </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="OPTIMIZER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Bottom" Margin="12,0,0,8"/>
              </StackPanel>
              <TextBlock Text="Rendimiento sin límites · todo reversible" FontSize="13.5" Foreground="{StaticResource TextDim}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border VerticalAlignment="Center" CornerRadius="18" Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Stroke2}" BorderThickness="1" Padding="16,8">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Effect="{StaticResource GlowAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="CountText" Text="0 seleccionados · 0 aplicados" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSub}"/>
            </StackPanel>
          </Border>
          </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1">
          <!-- ================= Optimizaciones ================= -->
          <TabItem Header="Optimizaciones">
            <Grid Margin="0,18,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Perfiles + compartir configuracion -->
              <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16,20,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <TextBlock Text="PERFILES" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="ProfileLabel" Text="Selección manual" FontSize="13.5" Foreground="{StaticResource TextSub}"
                                 Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <WrapPanel x:Name="ProfileBar" Margin="0,0,0,-8"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button x:Name="BtnSaveProfile" Style="{StaticResource BtnSubtle}" Content="Guardar perfil" Margin="0,0,6,0"
                            ToolTip="Guarda lo marcado como un perfil propio"/>
                    <Button x:Name="BtnExport" Style="{StaticResource BtnSubtle}" Content="Exportar código" Margin="0,0,6,0"
                            ToolTip="Copia tu configuración al portapapeles para compartirla"/>
                    <Button x:Name="BtnImport" Style="{StaticResource BtnSubtle}" Content="Importar código" Margin="0"
                            ToolTip="Pega un código de Sothe para marcar sus ajustes"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Barra de herramientas: busqueda, filtros y vista -->
              <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100*" MaxWidth="480"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,14,0">
                  <TextBox x:Name="SearchBox" Padding="38,9,12,9" Tag="Buscar ajustes… (ej. ratón, telemetría, red)"/>
                  <Path Data="M 0,6.5 A 6.5,6.5 0 1 1 13,6.5 A 6.5,6.5 0 1 1 0,6.5 Z M 11.2,11.2 L 16,16" Stroke="{StaticResource TextDim}"
                        StrokeThickness="1.8" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="14,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <ComboBox x:Name="CatCombo" Grid.Column="2" Width="220" Margin="0,0,18,0"/>

                <CheckBox x:Name="AdvancedChk" Grid.Column="3" Style="{StaticResource DangerSwitch}" Content="Modo avanzado"
                          VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="Muestra los ajustes PROHIBIDOS"/>

                <Border Grid.Column="4" CornerRadius="10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke2}"
                        BorderThickness="1" Padding="3" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ViewList" Style="{StaticResource Seg}" GroupName="View" IsChecked="True" ToolTip="Lista compacta">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,1 L 14,1 M 0,6 L 14,6 M 0,11 L 14,11" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Lista"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ViewGrid" Style="{StaticResource Seg}" GroupName="View" ToolTip="Cuadrícula para pantallas anchas">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,0 H 5.5 V 5.5 H 0 Z M 8.5,0 H 14 V 5.5 H 8.5 Z M 0,8.5 H 5.5 V 14 H 0 Z M 8.5,8.5 H 14 V 14 H 8.5 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Cuadrícula"/>
                      </StackPanel>
                    </RadioButton>
                  </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock Text="RIESGO" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <WrapPanel x:Name="RiskChips" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Lista de ajustes -->
              <Grid Grid.Row="2" Margin="0,16,0,0">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource Card}" Padding="0">
                  <Grid>
                    <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,6,6">
                      <StackPanel x:Name="RootList" Margin="18,0,12,10"/>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="Ningún ajuste coincide con los filtros" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Prueba otra búsqueda, cambia el nivel de riesgo o activa el Modo avanzado." Foreground="{StaticResource TextDim}"
                                 Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>

              <!-- Estado y progreso -->
              <StackPanel Grid.Row="3" Margin="4,14,4,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSub}" TextWrapping="Wrap"
                           Text="Al abrir se marca lo que ya tienes aplicado. Crea un punto de restauración antes de tocar nada."/>
                <ProgressBar x:Name="Progress" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
              </StackPanel>

              <!-- Acciones -->
              <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoRestoreChk" Style="{StaticResource DangerSwitch}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                              Content="Punto de restauración al aplicar" ToolTip="Crea un punto de restauración de Windows antes del primer lote de cambios de cada sesión"/>
                    <Button x:Name="BtnRestore" Style="{StaticResource Btn}" Content="Punto de restauración" Margin="0,0,8,0"/>
                    <Button x:Name="BtnClean" Style="{StaticResource Btn}" Content="Limpiar basura" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRevertAll" Style="{StaticResource BtnDanger}" Content="Revertir TODO" Margin="0"
                            ToolTip="Deshace todo lo aplicado por Toji, lo último primero"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnApply" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0" Padding="30,8"
                            ToolTip="Aplica lo marcado y revierte lo desmarcado que estaba aplicado">
                      <StackPanel>
                        <TextBlock Text="APLICAR" FontSize="15.5" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock Text="deja el sistema exacto a lo marcado" FontSize="11.5" FontWeight="SemiBold" Opacity="0.85" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnDry" Style="{StaticResource Btn}" Content="Simular" Margin="0" Padding="20,12"
                            ToolTip="Muestra qué haría APLICAR sin tocar nada"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>

          <!-- ================= Apps (Winget) ================= -->
          <TabItem x:Name="TabApps" Header="Apps (Winget)">
            <Grid Margin="0,18,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Apps" FontSize="24" FontWeight="Bold"/>
                  <TextBlock Text="Instala tus programas de un clic con winget. Cada operación abre una ventana con su progreso."
                             Foreground="{StaticResource TextSub}" FontSize="14.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="WingetPill" CornerRadius="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke2}"
                          BorderThickness="1" Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="WingetDot" Width="8" Height="8" Fill="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                      <TextBlock x:Name="WingetText" Text="winget: comprobando…" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSub}"/>
                    </StackPanel>
                  </Border>
                  <Button x:Name="BtnAppsRefresh" Style="{StaticResource BtnSubtle}" Content="Detectar instaladas" Margin="8,0,0,0"
                          ToolTip="Vuelve a comprobar qué apps tienes instaladas"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100*" MaxWidth="480"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,14,0">
                  <TextBox x:Name="AppSearch" Padding="38,9,12,9" Tag="Buscar apps… (ej. steam, discord, nmap)"/>
                  <Path Data="M 0,6.5 A 6.5,6.5 0 1 1 13,6.5 A 6.5,6.5 0 1 1 0,6.5 Z M 11.2,11.2 L 16,16" Stroke="{StaticResource TextDim}"
                        StrokeThickness="1.8" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="14,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="AppCountText" Grid.Column="2" Text="0 seleccionadas" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentHi}" VerticalAlignment="Center"/>
              </Grid>

              <Grid Grid.Row="2" Margin="0,16,0,0">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource Card}" Padding="0">
                  <ScrollViewer x:Name="AppScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,6,6">
                    <StackPanel x:Name="AppList" Margin="18,0,12,10"/>
                  </ScrollViewer>
                </Border>
              </Grid>

              <TextBlock x:Name="AppStatus" Grid.Row="3" Margin="4,14,4,0" Foreground="{StaticResource TextSub}" TextWrapping="Wrap"
                         Text="Marca las apps y pulsa Instalar. winget no instala drivers de GPU: usa «Drivers de GPU»."/>

              <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUpgrade" Style="{StaticResource Btn}" Content="Actualizar todo" Margin="0,0,8,0"
                            ToolTip="winget upgrade --all"/>
                    <Button x:Name="BtnGpu" Style="{StaticResource Btn}" Content="Drivers de GPU" Margin="0"
                            ToolTip="Detecta tu tarjeta gráfica y abre la web oficial de drivers"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnInstall" Style="{StaticResource BtnPrimary}" Content="Instalar seleccionadas" Margin="0,0,10,0" Padding="26,12"/>
                    <Button x:Name="BtnUninstall" Style="{StaticResource BtnDanger}" Content="Desinstalar seleccionadas" Margin="0" Padding="18,12"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>

          <!-- ================= Reparaciones ================= -->
          <TabItem Header="Reparaciones">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
              <StackPanel Margin="2,0,8,0">
                <TextBlock Text="Reparaciones" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Herramientas de mantenimiento de Windows. Las avanzadas abren su propia ventana con el progreso."
                           Foreground="{StaticResource TextSub}" FontSize="14.5" Margin="0,4,0,22" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource Safe}" Margin="0,0,10,0"/>
                  <TextBlock Text="BÁSICAS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Margin="0,0,0,14">
                  <Button x:Name="BtnClean2" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="Limpiar basura" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Vacía los temporales de usuario y de Windows y la papelera." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnFlushDns" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="Vaciar caché DNS" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Arregla webs que no cargan tras cambiar de red o de DNS." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource High}" Margin="0,0,10,0"/>
                  <TextBlock Text="AVANZADAS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel>
                  <Button x:Name="BtnSFC" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="SFC · reparar archivos" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Comprueba y repara archivos de sistema dañados (sfc /scannow)." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnDISM" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="DISM RestoreHealth" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Repara la imagen de Windows descargando lo necesario de Windows Update." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnNet" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="Reset de red completo" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Winsock + TCP/IP + DNS. Necesita reiniciar el PC." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnWU" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="Reparar Windows Update" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Reinicia sus servicios y regenera las cachés SoftwareDistribution y catroot2." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnChkdsk" Style="{StaticResource Tile}">
                    <StackPanel>
                      <TextBlock Text="Escanear disco (CHKDSK)" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="Busca errores en el disco del sistema sin desmontarlo (chkdsk /scan)." Foreground="{StaticResource TextSub}"
                                 FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ================= Caracteristicas de Windows ================= -->
          <TabItem x:Name="TabFeatures" Header="Características de Windows">
            <Grid Margin="0,18,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Características de Windows" FontSize="24" FontWeight="Bold"/>
                  <TextBlock Text="Activa o desactiva componentes opcionales de Windows. Casi todos piden reiniciar para completarse."
                             Foreground="{StaticResource TextSub}" FontSize="14.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnFeatRefresh" Grid.Column="1" Style="{StaticResource Btn}" Content="Refrescar estado" Margin="0" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="1" Margin="0,18,0,0">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource Card}" Padding="0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,6,6">
                    <StackPanel x:Name="FeatureList" Margin="18,12,12,10"/>
                  </ScrollViewer>
                </Border>
              </Grid>
              <TextBlock x:Name="FeatStatus" Grid.Row="2" Margin="4,14,4,0" Foreground="{StaticResource TextSub}" TextWrapping="Wrap"
                         Text="Consultando el estado de las características…"/>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- Firma del autor: discreta, a la derecha de las pestanas -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,4,0">
          <TextBlock x:Name="VersionText" Text="v1.0" FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
          <TextBlock Text="  ·  Creado por " FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
          <TextBlock Text="Sothe" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <!-- Notificacion flotante (toast) -->
      <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,96"
              CornerRadius="12" Background="#16122A" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="18,12"
              Opacity="0" IsHitTestVisible="False" Effect="{StaticResource GlowAccent}">
        <Border.RenderTransform>
          <TranslateTransform x:Name="ToastShift" Y="0"/>
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="ToastDot" Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock x:Name="ToastText" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
