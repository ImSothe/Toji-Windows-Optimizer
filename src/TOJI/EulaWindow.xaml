<Window x:Class="Toji.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOJI Celestial Optimizer · Aviso legal" Height="600" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource TojiWindow}">
  <Grid>
    <Rectangle Fill="{StaticResource Aura}" IsHitTestVisible="False"/>
    <Grid Margin="30,26,30,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
        <!-- Logo: Lanza Inversa del Cielo (daga de Toji) -->
        <Grid Width="44" Height="54" Margin="0,0,15,0">
            <Grid.RenderTransform>
                <!-- Inclinación característica de 45 grados -->
                <RotateTransform Angle="-45" CenterX="22" CenterY="27"/>
            </Grid.RenderTransform>

            <!-- Resplandor maldito de fondo -->
            <Path Data="M 23,2 L 29,8 L 29,26 L 11,26 L 11,16 L 17,10 L 17,20 L 23,20 Z" Fill="#A78BFA" Opacity="0.3">
                <Path.Effect>
                    <BlurEffect Radius="8"/>
                </Path.Effect>
            </Path>

            <!-- Hoja asimétrica principal (Filo de acero) -->
            <Path Data="M 23,2 L 29,8 L 29,26 L 11,26 L 11,16 L 17,10 L 17,20 L 23,20 Z" Fill="#E9E6F0"/>
    
            <!-- Grabado sutil en el centro de la hoja -->
            <Path Data="M 17,21 L 23,21 L 23,23 L 17,23 Z" Fill="#050505" Opacity="0.5"/>

            <!-- Tsuba (Guardia cruzada) -->
            <Path Data="M 7,26 L 33,26 L 33,29 L 7,29 Z" Fill="#2E1065"/>
    
            <!-- Mango (Tsuka) -->
            <Path Data="M 16,29 L 24,29 L 24,38 L 16,38 Z" Fill="#8B5CF6"/>
    
            <!-- Detalle visual del vendaje cruzado en el mango -->
            <Path Data="M 16,31 L 24,33 M 16,34 L 24,36" Stroke="#4C1D95" StrokeThickness="1.5"/>

            <!-- Argolla del pomo -->
            <Path Data="M 17,41 A 3,3 0 1 0 23,41 A 3,3 0 1 0 17,41" Stroke="#A78BFA" StrokeThickness="2" Fill="Transparent"/>

            <!-- Primer eslabón de la Cadena de los Mil Kilómetros -->
            <Path Data="M 18,46 A 2,3 0 1 0 22,46 A 2,3 0 1 0 18,46" Stroke="#8B5CF6" StrokeThickness="1.5" Fill="Transparent"/>
        </Grid>
        <StackPanel Margin="0" VerticalAlignment="Center">
          <TextBlock Text="TOJI" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrandGradient}"/>
          <TextBlock Text="Aviso legal · léelo antes de continuar" FontSize="13.5" Foreground="{StaticResource TextDim}"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock Foreground="{StaticResource TextSub}" TextWrapping="Wrap" FontSize="14.5" LineHeight="23"
            Text="TOJI es una herramienta para usuarios avanzados que modifica ajustes profundos de Windows (registro, servicios, seguridad).&#10;&#10;AL ACEPTAR, ENTIENDES Y ASUMES QUE:&#10;&#10;- Usas TOJI bajo tu propia responsabilidad y riesgo.&#10;- Algunos ajustes desactivan protecciones de seguridad o pueden causar inestabilidad, pérdida de datos o que Windows deje de arrancar.&#10;- Debes crear un punto de restauración antes de aplicar cambios.&#10;- Los ajustes marcados como PROHIBIDO están ocultos tras el Modo Avanzado y solo deben usarlos personas que sepan lo que hacen.&#10;- El autor de TOJI NO se hace responsable de ningún daño, pérdida de datos, inestabilidad ni de cualquier consecuencia derivada del uso del programa.&#10;- El software se ofrece 'TAL CUAL', sin garantía de ningún tipo.&#10;&#10;Si no estás de acuerdo, cierra el programa."/>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="2" Margin="0,20,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="© 2026 " FontSize="12.5" Foreground="{StaticResource TextDim}"/>
          <TextBlock Text="Sothe" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}"/>
          <TextBlock Text=" · TOJI Celestial Optimizer" FontSize="12.5" Foreground="{StaticResource TextDim}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnDecline" Style="{StaticResource Btn}" Content="No acepto" MinWidth="130" Margin="0,0,10,0"/>
          <Button x:Name="BtnAccept" Style="{StaticResource BtnPrimary}" Content="Acepto y continúo" MinWidth="170" Margin="0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
