<Window x:Class="Toji.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sothe Celestial Optimizer · Aviso legal" Height="600" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource TojiWindow}">
  <Grid>
    <Rectangle Fill="{StaticResource Aura}" IsHitTestVisible="False"/>
    <Grid Margin="30,26,30,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
        <!-- Logo: Lanza Inversa del Cielo (daga de Toji) -->
        <Viewbox Width="52" Height="52" Margin="0,0,15,0" VerticalAlignment="Center">
          <Viewbox.Effect>
            <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
          </Viewbox.Effect>
          <!-- Arma dibujada en vertical (pomo arriba) y girada -45 grados: mango arriba a la izquierda, punta abajo a la derecha -->
          <Canvas Width="116" Height="421">
            <Canvas.LayoutTransform>
              <RotateTransform Angle="-45"/>
            </Canvas.LayoutTransform>
            <Canvas>
              <Canvas.RenderTransform>
                <TranslateTransform X="-10" Y="-13"/>
              </Canvas.RenderTransform>

              <!-- Anilla del pomo -->
              <Path Stroke="#A89A5E" StrokeThickness="4">
                <Path.Data>
                  <EllipseGeometry Center="56,27" RadiusX="9" RadiusY="11"/>
                </Path.Data>
              </Path>

              <!-- Mango encintado granate: base, brillo cilindrico, vueltas de cinta y remate -->
              <Path Fill="#5A1E2E" Data="M 42,40 L 72,40 L 73,172 L 42,172 Z"/>
              <Path Fill="#7A2C40" Opacity="0.8" Data="M 48,40 L 54,40 L 54,172 L 48,172 Z"/>
              <Path Stroke="#2A0A12" StrokeThickness="3"
                    Data="M 42,48 L 73,54 M 42,60 L 73,66 M 42,72 L 73,78 M 42,84 L 73,90 M 42,96 L 73,102 M 42,108 L 73,114 M 42,120 L 73,126 M 42,132 L 73,138 M 42,144 L 73,150 M 42,156 L 73,162"/>
              <Path Fill="#2A0A12" Data="M 42,40 L 72,40 L 72,45 L 42,45 Z"/>

              <!-- Guardia negra en forma de sombrero con el ala en punta -->
              <Path Fill="#2B2B2F" Stroke="#6B6E75" StrokeThickness="2"
                    Data="M 22,205 L 22,194 Q 26,179 42,172 L 74,172 Q 86,184 124,197 L 118,204 Z"/>

              <!-- Hoja gris mate: bloque con bisel, pua lateral separada por la ranura y punta diagonal.
                   La segunda figura es la ventana rectangular, calada (EvenOdd): deja ver el fondo -->
              <Path Fill="#4B4D53" Stroke="#8C9098" StrokeThickness="2.5" StrokeLineJoin="Round"
                    Data="M 33,210 L 94,210 L 95,213 L 95,252 L 88,259 L 88,318 L 80,328 L 80,398 L 47,431 L 46,332 L 55,324 L 55,258 L 44,258 L 44,316 L 30,326 L 11,309 L 11,271 L 20,258 L 20,223 Z M 53,219 L 70,219 L 70,245 L 53,245 Z"/>
              <!-- Muescas de la ventana -->
              <Path Stroke="#2B2B2F" StrokeThickness="2" Data="M 50,229 L 53,229 M 70,229 L 73,229 M 50,236 L 53,236 M 70,236 L 73,236"/>
            </Canvas>
          </Canvas>
        </Viewbox>
        <StackPanel Margin="0" VerticalAlignment="Center">
          <TextBlock Text="SOTHE" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrandGradient}"/>
          <TextBlock Text="Aviso legal · léelo antes de continuar" FontSize="13.5" Foreground="{StaticResource TextDim}"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock Foreground="{StaticResource TextSub}" TextWrapping="Wrap" FontSize="14.5" LineHeight="23"
            Text="Sothe Celestial Optimizer es una herramienta para usuarios avanzados que modifica ajustes profundos de Windows (registro, servicios, seguridad).&#10;&#10;AL ACEPTAR, ENTIENDES Y ASUMES QUE:&#10;&#10;- Usas TOJI bajo tu propia responsabilidad y riesgo.&#10;- Algunos ajustes desactivan protecciones de seguridad o pueden causar inestabilidad, pérdida de datos o que Windows deje de arrancar.&#10;- Debes crear un punto de restauración antes de aplicar cambios.&#10;- Los ajustes marcados como PROHIBIDO están ocultos tras el Modo Avanzado y solo deben usarlos personas que sepan lo que hacen.&#10;- El autor de Sothe Celestial Optimizer NO se hace responsable de ningún daño, pérdida de datos, inestabilidad ni de cualquier consecuencia derivada del uso del programa.&#10;- El software se ofrece 'TAL CUAL', sin garantía de ningún tipo.&#10;&#10;Si no estás de acuerdo, cierra el programa."/>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="2" Margin="0,20,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="© 2026 " FontSize="12.5" Foreground="{StaticResource TextDim}"/>
          <TextBlock Text="Sothe" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}"/>
          <TextBlock Text=" · Sothe Celestial Optimizer" FontSize="12.5" Foreground="{StaticResource TextDim}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnDecline" Style="{StaticResource Btn}" Content="No acepto" MinWidth="130" Margin="0,0,10,0"/>
          <Button x:Name="BtnAccept" Style="{StaticResource BtnPrimary}" Content="Acepto y continúo" MinWidth="170" Margin="0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
