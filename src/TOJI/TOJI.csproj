<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TOJI</AssemblyName>
    <RootNamespace>Toji</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Sothe Celestial Optimizer</Product>
    <Company>Sothe</Company>
    <Authors>Sothe</Authors>
    <!-- Distribucion en un unico .exe: `dotnet publish -c Release` deja solo TOJI.exe, con el runtime de .NET
         dentro (no hay que instalar nada) y las librerias nativas de WPF incluidas en el propio ejecutable -->
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Licencias: huella del PC por WMI y cache cifrada con DPAPI -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Icono de la app (lo genera tools/IconGen a partir del logo): el .exe lo lleva como recurso Win32
       y las ventanas lo cargan como recurso WPF para la barra de tareas -->
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- Los JSON van incrustados en el .exe como valores por defecto. Si existe data\ junto al .exe (la crea la
       OTA al actualizar) se usa esa copia. En desarrollo tambien se copian a bin\ para poder editarlos sin
       recompilar; al publicar no se copian, para que el resultado sea un unico archivo -->
  <ItemGroup>
    <EmbeddedResource Include="data\*.json" LogicalName="data/%(Filename)%(Extension)" />
    <None Include="data\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
