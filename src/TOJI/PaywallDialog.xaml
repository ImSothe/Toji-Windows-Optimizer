<Window x:Class="Toji.PaywallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sothe PRO" Width="660" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Benefit" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="0,5,12,5"/>
    </Style>
  </Window.Resources>

  <Border Margin="28" CornerRadius="18" Background="#0E0C15" BorderBrush="{StaticResource Stroke2}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#7C3AED" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid>
      <Border CornerRadius="18" Background="{StaticResource Aura}" IsHitTestVisible="False"/>
      <StackPanel Margin="32,28,32,26">

        <!-- Cabecera -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="54" Height="54" CornerRadius="15" Background="{StaticResource AccentGradient}"
                  Effect="{StaticResource GlowAccent}" VerticalAlignment="Top">
            <Viewbox Width="24" Height="26">
              <Canvas Width="24" Height="26">
                <Path Data="M 6,11 V 7.5 A 6,6 0 0 1 18,7.5 V 11" Stroke="White" StrokeThickness="2.4" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                <Path Data="M 4.5,11 H 19.5 A 2,2 0 0 1 21.5,13 V 23 A 2,2 0 0 1 19.5,25 H 4.5 A 2,2 0 0 1 2.5,23 V 13 A 2,2 0 0 1 4.5,11 Z" Fill="White"/>
                <Ellipse Canvas.Left="10.5" Canvas.Top="15.5" Width="3" Height="3" Fill="#7C3AED"/>
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,2,12,0">
            <TextBlock x:Name="TitleText" Text="Desbloquea Sothe PRO" FontSize="23" FontWeight="Bold"/>
            <TextBlock x:Name="ReasonText" Foreground="{StaticResource TextSub}" FontSize="14.5" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="21"/>
          </StackPanel>
          <Button x:Name="BtnClose" Grid.Column="2" Style="{StaticResource BtnSubtle}" Padding="10" Margin="0" VerticalAlignment="Top" ToolTip="Ahora no">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
          </Button>
        </Grid>

        <!-- Lo que incluye -->
        <Border Margin="0,22,0,0" CornerRadius="12" Background="#0CFFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="18,10">
          <UniformGrid Columns="2">
            <StackPanel Style="{StaticResource Benefit}">
              <Path Data="M 1,5 L 4.5,8.5 L 11,1" Stroke="{StaticResource AccentHi}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="Ajustes PRO de rendimiento" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Style="{StaticResource Benefit}">
              <Path Data="M 1,5 L 4.5,8.5 L 11,1" Stroke="{StaticResource AccentHi}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="Guarda tus perfiles propios" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Style="{StaticResource Benefit}">
              <Path Data="M 1,5 L 4.5,8.5 L 11,1" Stroke="{StaticResource AccentHi}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="Base de ajustes actualizada (OTA)" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Style="{StaticResource Benefit}">
              <Path Data="M 1,5 L 4.5,8.5 L 11,1" Stroke="{StaticResource AccentHi}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="Licencia permanente, 1 PC" VerticalAlignment="Center"/>
            </StackPanel>
          </UniformGrid>
        </Border>

        <!-- Activar clave -->
        <TextBlock Text="¿YA TIENES LICENCIA?" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="0,22,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="KeyBox" Tag="Pega aquí tu clave" FontFamily="Cascadia Mono, Consolas" Margin="0,0,10,0"/>
          <Button x:Name="BtnActivate" Grid.Column="1" Style="{StaticResource Btn}" Content="Activar" Margin="0" MinWidth="120" IsDefault="True"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Extreme}" FontSize="13.5" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="Collapsed"/>

        <!-- Separador -->
        <Grid Margin="0,20,0,16">
          <Border Height="1" Background="{StaticResource Stroke2}" VerticalAlignment="Center"/>
          <Border Background="#0E0C15" HorizontalAlignment="Center" Padding="14,0">
            <TextBlock Text="o" Foreground="{StaticResource TextDim}"/>
          </Border>
        </Grid>

        <!-- Comprar / Probar / Validar -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnBuy" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Padding="20,12">
            <TextBlock Text="Comprar Sothe PRO" FontSize="15"/>
          </Button>
          <Button x:Name="BtnTrial" Grid.Column="1" Style="{StaticResource Btn}" Margin="6,0,0,0" Padding="20,12" Content="Probar 7 días gratis"/>
          <Button x:Name="BtnRetry" Grid.Column="1" Style="{StaticResource Btn}" Margin="6,0,0,0" Padding="20,12" Content="Validar ahora" Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="FootText" Margin="0,18,0,0" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Puedes seguir explorando todo sin licencia. Revertir cambios es siempre gratis."/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
