    <Compile Include="..\..\src\SotheOptimizer\SystemPaths.cs" Link="App\SystemPaths.cs" />
    <Compile Include="..\..\src\SotheOptimizer\SecureStorage.cs" Link="App\SecureStorage.cs" />
